# swaylock-effects, used in VirtualBox instead of hyprlock (hypr/scripts/lock.sh).
# Colours are RRGGBB[AA], no '#'.

# --- Behaviour ---------------------------------------------------------------
ignore-empty-password
show-failed-attempts
indicator-caps-lock
show-keyboard-layout
daemonize

# --- Background: blurred screenshot of the desktop (CPU), Mocha base fallback --
screenshots
effect-blur=7x4
effect-vignette=0.4:0.8
color=1e1e2e
fade-in=0.2

# --- Clock inside the ring ----------------------------------------------------
clock
indicator
timestr=%H:%M
datestr=%A %d %B
font=JetBrainsMono Nerd Font
font-size=28
indicator-radius=110
indicator-thickness=8

# --- Ring ---------------------------------------------------------------------
ring-color=cba6f7
ring-clear-color=f5e0dc
ring-caps-lock-color=f9e2af
ring-ver-color=fab387
ring-wrong-color=f38ba8
key-hl-color=b4befe
bs-hl-color=f5e0dc
caps-lock-key-hl-color=a6e3a1
caps-lock-bs-hl-color=f5e0dc

# --- Inside (Mocha surface, slightly transparent) --------------------------------
inside-color=1e1e2ecc
inside-clear-color=1e1e2ecc
inside-caps-lock-color=1e1e2ecc
inside-ver-color=1e1e2ecc
inside-wrong-color=1e1e2ecc

# --- Text ---------------------------------------------------------------------
text-color=cdd6f4
text-clear-color=f5e0dc
text-caps-lock-color=f9e2af
text-ver-color=fab387
text-wrong-color=f38ba8
layout-text-color=a6adc8
layout-bg-color=00000000
layout-border-color=00000000

# --- No separator / lines ---------------------------------------------------------
separator-color=00000000
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
