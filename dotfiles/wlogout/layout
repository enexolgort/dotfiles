{
    "label" : "logout",
    "action" : "uwsm stop || hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "Sign out",
    "keybind" : "e"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shut Down",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Restart",
    "keybind" : "r"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "cancel",
    "action" : "true",
    "text" : "Cancel",
    "keybind" : "c"
}
