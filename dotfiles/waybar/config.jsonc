{
    "layer": "top",
    "position": "top",
    // exclusive: reserve the bar's height so tiled windows start below it
    // instead of sliding underneath.
    "exclusive": true,
    "height": 30,
    "spacing": 4,

    // custom/gpu is defined below but left off the bar: its script needs
    // nvtop (not installed) and the tooltip names the original author's
    // own iGPU. Add it back here if you install nvtopPackages.full.
    "modules-left": ["hyprland/workspaces", "cpu", "memory", "temperature"],
    "modules-center": ["clock"],
    "modules-right": ["mpris", "network", "bluetooth", "pulseaudio", "battery", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        // Lua-config syntax: `hyprctl dispatch` takes hl.dsp.* calls now
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },

    // WiFi controller: click = rofi network picker, right-click = full
    // NetworkManager editor. nm-applet in the tray covers the rest.
    "network": {
        "format-wifi": "󰖩  {essid}",
        "format-ethernet": "󰈀  {ipaddr}",
        "format-disconnected": "󰖪  Offline",
        "format-disabled": "󰖪  Off",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr} on {ifname}",
        "tooltip-format-ethernet": "{ipaddr}/{cidr} on {ifname}",
        "on-click": "~/.config/hypr/scripts/wifi-menu.sh",
        "on-click-right": "nm-connection-editor",
        "interval": 5
    },

    // Bluetooth controller button: click = Blueman device manager
    // (pair/connect), right-click = power the adapter on/off.
    // format-no-controller keeps the button visible even with no adapter
    // (e.g. the janus-vm VirtualBox guest) — waybar hides it otherwise.
    "bluetooth": {
        "format": "󰂯",
        "format-on": "󰂯",
        "format-off": "󰂲",
        "format-disabled": "󰂲",
        "format-no-controller": "󰂲",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}  {status}\nClick: devices · Right-click: power",
        "tooltip-format-connected": "{controller_alias}  {num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}  {device_battery_percentage}%",
        "tooltip-format-no-controller": "No Bluetooth adapter\nClick: open Blueman",
        "on-click": "blueman-manager",
        "on-click-right": "sh -c 'bluetoothctl show | grep -q \"Powered: yes\" && bluetoothctl power off || bluetoothctl power on'"
    },

    // Absent entirely on machines without a battery
    "battery": {
        "states": { "warning": 25, "critical": 10 },
        "format": "{icon}  {capacity}%",
        "format-charging": "󰂄  {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󱊣", "󰁹"]
    },

    // Required for nm-applet / blueman-applet icons to show up at all
    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2
    },

    "memory": {
        "format": "RAM {percentage}%",
        "tooltip-format": "{used} / {total}GiB",
        "interval": 2
    },

    "custom/gpu": {
        "exec": "/home/rp34/.config/waybar/scripts/gpu_usage.sh",
        "interval": 2,
        "format": "GPU {}%",
        "tooltip-format": "Skylake-H GT2: {}%"
    },
    
    "temperature": {
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip": true,
        "tooltip-format": "CPU Temp: {temperatureC}°C",
        "interval": 2
    },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "mpris": {
        "format": "{title} - {artist}",
        "format-paused": "{title} - {artist}",
        "max-length": 50,
        "tooltip": false,
        "interval": 2
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip": false,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/hypr/scripts/power-menu.sh"
    }
}