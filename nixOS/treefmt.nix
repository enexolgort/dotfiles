_: {
  projectRootFile = "flake.nix";

  programs.alejandra.enable = true;

  # Lints, run by `nix fmt` and the formatting check. Lambda arguments
  # stay: modules take { config, pkgs, lib, vars, ... } whether or not
  # they use every one.
  programs.deadnix = {
    enable = true;
    no-lambda-arg = true;
    no-lambda-pattern-names = true;
  };
  programs.statix.enable = true;

  # Machine-generated by nixos-generate-config; never reformatted by hand.
  settings.global.excludes = ["hosts/*/hardware-configuration.nix"];
}
